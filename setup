#!/usr/bin/env bash
# Judgement — One-time setup. Detects platform, installs dependencies.
set -e
cd "$(dirname "$0")"

echo "=== Judgement Setup ==="
echo ""

# --- Detect platform ---
OS="$(uname -s)"
HW_ARCH="$(uname -m)"

# On macOS Apple Silicon, detect the NATIVE arch (not Rosetta)
# sysctl hw.optional.arm64 = 1 means Apple Silicon regardless of Rosetta
NATIVE_ARCH="$HW_ARCH"
if [ "$OS" = "Darwin" ] && sysctl -n hw.optional.arm64 2>/dev/null | grep -q 1; then
    NATIVE_ARCH="arm64"
fi

echo "Platform:    $OS $HW_ARCH"
echo "Native arch: $NATIVE_ARCH"
echo "Python:      $(python3 --version 2>&1)"
echo "Node:        $(node --version 2>&1 || echo 'NOT FOUND')"
echo ""

# On Apple Silicon, use arch command to force native arch for pip
# This ensures wheels match the user's Terminal (which runs natively)
if [ "$OS" = "Darwin" ] && [ "$NATIVE_ARCH" = "arm64" ]; then
    PIP="arch -arm64 pip3"
    PYTHON="arch -arm64 python3"
    echo "Note: Installing packages for arm64 (Apple Silicon native)"
    echo ""
else
    PIP="pip3"
    PYTHON="python3"
fi

# --- Check prerequisites ---
if ! command -v python3 &>/dev/null; then
    echo "ERROR: python3 not found. Install Python 3.9+ first."
    exit 1
fi

if ! command -v node &>/dev/null; then
    echo "ERROR: node not found. Install Node.js 18+ first."
    exit 1
fi

if ! command -v npm &>/dev/null; then
    echo "ERROR: npm not found. Install Node.js 18+ first."
    exit 1
fi

# --- Python dependencies ---
echo "Installing Python dependencies..."
$PIP install -r backend/requirements.txt

# Verify pydantic works under native arch
if ! $PYTHON -c "from pydantic_core import __version__" 2>/dev/null; then
    echo "Fixing pydantic architecture mismatch..."
    $PIP install --force-reinstall pydantic pydantic-core
fi

# Verify
$PYTHON -c "from pydantic_core import __version__; print('  pydantic_core OK')"

# --- Desktop support (pywebview) ---
echo ""
echo "Installing desktop app support (pywebview)..."
if [ "$OS" = "Darwin" ]; then
    $PIP install pywebview 2>&1 | tail -3
elif [ "$OS" = "Linux" ]; then
    $PIP install pywebview 2>&1 | tail -3
    echo "  Note: you may need: sudo apt install python3-gi gir1.2-webkit2-4.1"
else
    $PIP install pywebview 2>&1 | tail -3
fi

# Verify pywebview
if $PYTHON -c "import webview" 2>/dev/null; then
    echo "  pywebview OK — desktop mode enabled"
else
    echo "  pywebview not available — will use browser mode"
fi

# --- Final pydantic check (pywebview/pyobjc install can break it) ---
if ! $PYTHON -c "from pydantic_core import __version__" 2>/dev/null; then
    echo ""
    echo "Fixing pydantic after pywebview install..."
    $PIP install --force-reinstall pydantic pydantic-core
    $PYTHON -c "from pydantic_core import __version__; print('  pydantic_core OK')"
fi

# --- Frontend dependencies ---
echo ""
echo "Installing frontend dependencies..."
cd frontend && npm install
cd ..

# --- Build frontend ---
echo ""
echo "Building frontend..."
cd frontend && npm run build
cd ..

# --- Verify everything works ---
echo ""
echo "Verifying setup..."

# Test that the server can start
if $PYTHON -c "from backend.app.main import app; print('  Backend OK')" 2>/dev/null; then
    :
else
    echo "  ERROR: Backend failed to load. Check errors above."
    exit 1
fi

# --- Done ---
echo ""
echo "=== Setup Complete ==="
echo ""
echo "To play:  ./play"
echo ""
